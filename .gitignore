# ─── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
venv/
.venv/
env/
*.egg-info/
.Python

# ─── Environnement ────────────────────────────────────────
backend/.env
.env

# ─── Frontend build (généré par vite build) ───────────────
backend/static/

# ─── Node ─────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/

