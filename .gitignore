data/models/*
!data/models/README.md

data/indexes/*
!data/indexes/README.md

# tasks = état runtime du moteur de tâches — jamais versionné
data/tasks/

# logs = journal d'exploitation, un sous-dossier par poste — jamais versionné
data/logs/

